---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Accordion from '../components/Accordion.astro';
import { getEntry } from 'astro:content';

const homeData = await getEntry('home', 'home');
if (!homeData) {
  throw new Error('Home data not found');
}
const data = homeData.data;
---

<Layout title="Home">
  <Header />
  
  <div class="max-w-[1920px] w-full my-6 lg:my-12 mx-auto px-6 md:px-8 flex flex-row">
    <div class="home-content">
      <h2 class="text-[28px] font-cormorant mb-6">Willkommen in Arandor</h2>
      <p>{data.text}</p>
      
      <div class="mt-6 md:mt-12">
        <label for="progressLevel" class="flex items-center justify-between">
          <span>Level {data.currentlevel}</span> 
          <span>Level {data.nextlevel}</span>
        </label>
        <progress class="block w-full" id="progressLevel" value={data.levelprogress} max="100"></progress>
      </div>

      <div class="grid grid-cols-1 gap-12 mt-6 mb-12 md:grid-cols-2 2xl:grid-cols-3 lg:mt-12">
        <div class="grid grid-cols-1 2xl:grid-cols-2 2xl:gap-12 2xl:col-span-2">
          <div>
            <h2 class="text-[28px] font-cormorant mt-6 md:mt-0 mb-6">Fraktionen</h2>
            <h3 class="text-[21px] font-cormorant mb-3">Arandor</h3>
            <div>
              <label for="progressRulik" class="flex items-center justify-between">
                <span>Rulik</span> 
                <span class="capitalize">{data.rulikselect}</span>
              </label>
              <progress class={`block w-full ${data.rulikselect}`} id="progressRulik" value={data.rulikprogress} max="100"></progress>
            </div>
            <div class="mt-4">
              <label for="progressIrileth" class="flex items-center justify-between">
                <span>Irileth</span> 
                <span class="capitalize">{data.irilethselect}</span>
              </label>
              <progress class={`block w-full ${data.irilethselect}`} id="progressIrileth" value={data.irilethprogress} max="100"></progress>
            </div>
            <div class="mt-4">
              <label for="progressMardunien" class="flex items-center justify-between">
                <span>Mardunien</span> 
                <span class="capitalize">{data.mardunienselect}</span>
              </label>
              <progress class={`block w-full ${data.mardunienselect}`} id="progressMardunien" value={data.mardunienprogress} max="100"></progress>
            </div>
            
            <h3 class="text-[21px] font-cormorant mb-3 mt-6 md:mt-12">Molea</h3>
            <div>
              <label for="progressSianische" class="flex items-center justify-between">
                <span>Sianische Lande</span> 
                <span class="capitalize">{data.sianischelandeselect}</span>
              </label>
              <progress class={`block w-full ${data.sianischelandeselect}`} id="progressSianische" value={data.sianischelandeprogress} max="100"></progress>
            </div>
            <div class="mt-4">
              <label for="progressRegusanien" class="flex items-center justify-between">
                <span>Regusanien</span> 
                <span class="capitalize">{data.regusanienselect}</span>
              </label>
              <progress class={`block w-full ${data.regusanienselect}`} id="progressRegusanien" value={data.regusanienprogress} max="100"></progress>
            </div>
            <div class="mt-4">
              <label for="progressKongdonien" class="flex items-center justify-between">
                <span>Kongdonien</span> 
                <span class="capitalize">{data.kongdonienselect}</span>
              </label>
              <progress class={`block w-full ${data.kongdonienselect}`} id="progressKongdonien" value={data.kongdonienprogress} max="100"></progress>
            </div>
          </div>

          <div>
            <h2 class="text-[28px] mt-12 2xl:mt-0 font-cormorant mb-6">Quests</h2>
            <Accordion items={data.accordion} />
          </div>
        </div>
        
        <div>
          <h2 class="text-[28px] font-cormorant mb-6">Characters</h2>
          <p class="text-sm text-gray-400">Character list will be displayed here</p>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
